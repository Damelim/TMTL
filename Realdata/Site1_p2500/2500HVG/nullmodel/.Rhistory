######### Functions required for all ###########
generate_data <- function(N = 1e6, m = 5000, seed = 1) {
set.seed(seed)
# Target population
x1 <- rnorm(N, mean = 1, sd = 1)
x2 <- rnorm(N, mean = 1, sd = 1)
tau_fun <- function(x1, x2) {
cos(1) + cos(x1) + cos(x2) - 3/2
}
tau_true <- tau_fun(x1, x2)
d_star <- as.numeric(tau_true > 0)
# Arm-specific potential outcomes
e0 <- rnorm(N, mean = 0, sd = 0.5)
e1 <- rnorm(N, mean = 0, sd = 0.5)
y_0 <- 1 + 2 * x1 + 3 * x2 + e0 # Y(0) | X ~ N(1 + 2x1 + 3x2, 0.5^2)
y_1 <- 1 + 2 * x1 + 3 * x2 + tau_true + e1 # Y(1) | X ~ N(1 + 2x1 + 3x2 + \tau(x), 0.5^2)
# RWD: random sample from target population
rwdidx <- sample.int(N, size = m, replace = FALSE)
x1_rwd <- x1[rwdidx]
x2_rwd <- x2[rwdidx]
# Create RCT X
alpha0 <- -8
alpha1 <- c(1, -2)
logit_ps <- alpha0 + alpha1[1] * x1 + alpha1[2] * x2
ps <- plogis(logit_ps)
S <- rbinom(N, size = 1, prob = ps)
rctidx <- which(S == 1)
x1_rct <- x1[rctidx]
x2_rct <- x2[rctidx]
# Create RCT A
A_rct <- rbinom(length(rctidx), size = 1, prob = 0.5)
# Create RCT Y
Y_rct <- ifelse(A_rct == 1, y_1[rctidx], y_0[rctidx])
return(list(
N = N,
m = m,
seed = seed,
x1 = x1,
x2 = x2,
y_0 = y_0,
y_1 = y_1,
tau_fun = tau_fun,
tau_true = tau_true,
d_star = d_star,
rwdidx = rwdidx,
x1_rwd = x1_rwd,
x2_rwd = x2_rwd,
alpha0 = alpha0,
alpha1 = alpha1,
logit_ps = logit_ps,
ps = ps,
S = S,
rctidx = rctidx,
x1_rct = x1_rct,
x2_rct = x2_rct,
A_rct = A_rct,
Y_rct = Y_rct
))
}
l_loss <- function(u){ # Full smoothed ramp loss l(u)
ifelse(
u >= 1, 0,
ifelse(
u >= 0, (1 - u)^2,
ifelse(
u >= -1, 2 - (1 + u)^2,
2
)
)
)
}
l1_loss <- function(u){ # l_1(u) in the paper: convex part
ifelse(
u >= 1, 0,
ifelse(
u >= 0, (1 - u)^2,
1 - 2 * u
)
)
}
l1_grad <- function(u) {
ifelse(
u >= 1, 0,
ifelse(
u >= 0, -2 * (1 - u),
-2
)
)
}
l0_loss <- function(u) { # l_0(u) in the paper: convex part used in DC decomposition
ifelse(
u >= 0, 0,
ifelse(
u >= -1, u^2,
-2 * u - 1
)
)
}
l0_grad <- function(u) {
ifelse(
u >= 0, 0,
ifelse(
u >= -1, 2 * u,
-2
)
)
}
uu = seq(-4,4,by = 0.001)
plot(uu, 1- l1_loss(uu) + l0_loss(uu), type="l")
dev.off(])
dev.off(
)
plot(uu, 1- l1_loss(uu) + l0_loss(uu), type="l")
pp = seq(0,1,by=0.0001)
f = function(p){
p*(1-p)*(1-2*p)
}
plot(pp,f(pp),type="l")
min(f(pp))
