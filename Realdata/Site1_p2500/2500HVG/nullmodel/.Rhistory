d <- predict_policy(model,X)
A <- source$A
Y <- source$Y
piA <- 0.5
Q1 <- predict(m1,X)
Q0 <- predict(m0,X)
Qd <- ifelse(d==1,Q1,Q0)
term <- w*((A*d)/piA + ((1-A)*(1-d))/(1-piA)) *
(Y - ifelse(A==1,Q1,Q0))
mean(term + Qd)
}
# =========================
# (6) TRUE VALUE
# =========================
true_value <- function(sim,model){
target <- sim$target
X <- target[, -(1:3)]
colnames(X) <- paste0("x",1:ncol(X))
d <- predict_policy(model,X)
mean(ifelse(d==1,target$Y1,target$Y0))
}
# =========================
# (7) RUN
# =========================
sim <- simulate_data(
n_source = 10000,
n_target= 10000,
p=10,
covariate_mean_shift=c(0.3,0.2,0.1,rep(0,7)),
c_shift=1
)
w_res <- get_weights(sim)
tau_res <- get_tau_aw(sim)
model <- dc_policy(tau_res$X,tau_res$tau,w_res$w)
V_hat <- estimate_value(sim,model,w_res$w,tau_res$m1,tau_res$m0)
V_true <- true_value(sim,model)
cat("Estimated:",V_hat,"\n")
cat("True:",V_true,"\n")
#### Things to consider ####
# 1) high-dimensionality
# 2) magnitude of covariate shift
# 3) noise in covariate generation / noise in outcome model
# 4) sample size
# 5) DC algorithm
# 6) \delta(x)
library(mvtnorm)
# =========================
# (0) DATA GENERATION (그대로)
# =========================
simulate_data <- function(n_source = 1000, n_target = 1000, p = 20,
covariate_mean_shift = rep(0,p), c_shift = 0.8, seed = 1) {
set.seed(seed)
Sigma <- 0.1 * diag(p)
X_source <- rmvnorm(n_source, rep(0,p), Sigma)
X_target <- rmvnorm(n_target, covariate_mean_shift, Sigma)
gamma <- rep(1,p)/sqrt(p)
alpha <- (-1)^(1:p)/sqrt(p)
m0 <- function(X) as.vector(0.5 + X %*% gamma)
tau_S <- function(X) as.vector(X %*% alpha)
Y0_source <- m0(X_source)
Y1_source <- m0(X_source) + tau_S(X_source)
A <- rbinom(n_source,1,0.5)
Y <- ifelse(A==1,Y1_source,Y0_source) + rnorm(n_source,0,0.2)
source <- data.frame(S=1,A=A,Y=Y,X_source)
# robust 필요하게 δ
delta <- function(X){
tau <- tau_S(X)
c_shift * pmax(tau, 0)
}
tau_T <- function(X) tau_S(X) - delta(X)
Y0_target <- m0(X_target)
Y1_target <- m0(X_target) + tau_T(X_target)
target <- data.frame(S=0,Y0=Y0_target,Y1=Y1_target,X_target)
list(source=source, target=target)
}
# =========================
# (1) SPLIT DATA
# =========================
split_source <- function(source, ratio=0.5){
n <- nrow(source)
idx <- sample(1:n, floor(ratio*n))
train <- source[idx,]
eval  <- source[-idx,]
list(train=train, eval=eval)
}
# =========================
# (2) TRANSFER WEIGHT (train)
# =========================
get_weights <- function(train, target){
Xs <- train[, -(1:3)]
Xt <- target[, -(1:3)]
colnames(Xs) <- colnames(Xt) <- paste0("x",1:ncol(Xs))
pooled <- rbind(
data.frame(S=1,Xs),
data.frame(S=0,Xt)
)
fit <- glm(S~., data=pooled, family=binomial)
ps <- predict(fit, newdata=Xs, type="response")
ps <- pmax(ps,1e-3)
w <- 1/ps
list(w=w, X=Xs)
}
# =========================
# (3) τ_aw (train)
# =========================
get_tau_aw <- function(train){
X <- train[, -(1:3)]
colnames(X) <- paste0("x",1:ncol(X))
m1 <- lm(Y~., data=data.frame(Y=train$Y[train$A==1], X[train$A==1,]))
m0 <- lm(Y~., data=data.frame(Y=train$Y[train$A==0], X[train$A==0,]))
m1_hat <- predict(m1,X)
m0_hat <- predict(m0,X)
piA <- 0.5
tau_aw <- ifelse(train$A==1,
(train$Y - m1_hat)/piA + m1_hat - m0_hat,
-(train$Y - m0_hat)/(1-piA) + m1_hat - m0_hat)
list(tau=tau_aw, X=X, m1=m1, m0=m0)
}
# =========================
# (4) LOSS
# =========================
l1 <- function(u){
ifelse(u>=1,0,
ifelse(u>=0,(1-u)^2,
2-(1+u)^2))
}
l1_grad <- function(u){
ifelse(u>=1,0,
ifelse(u>=0,-2*(1-u),
-2*(1+u)))
}
l0_prime <- function(u){
ifelse(u>=0,0,
ifelse(u>=-1,2*(1+u),0))
}
# =========================
# (5) DC (train)
# =========================
dc_policy <- function(X,tau,w,max_iter=50,lr=0.01){
X <- as.matrix(X)
eta <- rep(0,ncol(X))
for(t in 1:max_iter){
f <- X %*% eta
s <- (2*(tau>0)-1)
u <- s * f
xi <- -w*abs(tau)*l0_prime(u)
grad <- rep(0,length(eta))
for(i in 1:nrow(X)){
grad <- grad +
w[i]*abs(tau[i])*l1_grad(u[i])*s[i]*X[i,] +
xi[i]*s[i]*X[i,]
}
grad <- grad/nrow(X)
eta <- eta - lr*grad
}
list(eta=eta)
}
predict_policy <- function(model,X){
as.numeric(as.matrix(X)%*%model$eta>0)
}
# =========================
# (6) VALUE (eval set만 사용)
# =========================
estimate_value <- function(eval, model, m1, m0){
X <- eval[, -(1:3)]
colnames(X) <- paste0("x",1:ncol(X))
d <- predict_policy(model, X)
A <- eval$A
Y <- eval$Y
piA <- 0.5
Q1 <- predict(m1, X)
Q0 <- predict(m0, X)
Qd <- ifelse(d==1, Q1, Q0)
term <- ((A*d)/piA + ((1-A)*(1-d))/(1-piA)) *
(Y - ifelse(A==1,Q1,Q0))
mean(term + Qd)
}
# =========================
# (7) TRUE VALUE
# =========================
true_value <- function(target, model){
X <- target[, -(1:3)]
colnames(X) <- paste0("x",1:ncol(X))
d <- predict_policy(model, X)
mean(ifelse(d==1,target$Y1,target$Y0))
}
# =========================
# (8) RUN
# =========================
sim <- simulate_data(
n_source = 4000,
n_target = 4000,
p = 10,
covariate_mean_shift=c(0.3,0.2,0.1,rep(0,7)),
c_shift=1
)
split <- split_source(sim$source)
train <- split$train
eval  <- split$eval
w_res <- get_weights(train, sim$target)
tau_res <- get_tau_aw(train)
model <- dc_policy(tau_res$X, tau_res$tau, w_res$w)
V_hat <- estimate_value(eval, model, tau_res$m1, tau_res$m0)
V_true <- true_value(sim$target, model)
cat("Estimated:",V_hat,"\n")
cat("True:",V_true,"\n")
