all[[length(all)+1]] <- simulate(m, x0, seed = 1000*s)
}
}
dat <- do.call(rbind, all)
ylim <- range(dat$F)
plot(NA, xlim = c(0,T), ylim = ylim,
xlab = "Iteration", ylab = "F(x)",
main = paste("Init =", round(x0[1],2)))
## individual trajectories (thin)
for (m in methods) {
sub <- dat[dat$method == m, ]
for (s in 1:num_rep) {
lines(sub$iter[(s-1)*(T+1)+1:(T+1)],
sub$F[(s-1)*(T+1)+1:(T+1)],
col = adjustcolor(cols[m], alpha.f = 0.25))
}
}
## mean trajectories (thick)
for (m in methods) {
sub <- dat[dat$method == m, ]
meanF <- tapply(sub$F, sub$iter, mean)
lines(as.numeric(names(meanF)), meanF,
col = cols[m], lwd = 3)
}
legend("topright",
legend = c("Parallel", "Proposed",
"ZORO + Parallel", "ZORO + Proposed"),
col = cols, lwd = 3, bty = "n")
}
#dev.off()
warnings()
################################################################################
######## Multivariate (d = 20) FO + ZO mixed experiment ##########################
######## Compare 4 methods with correct scaling #################################
######## 1) Parallel
######## 2) Proposed (FO surrogate, NO ZORO)
######## 3) ZORO + Parallel
######## 4) ZORO + Proposed
################################################################################
set.seed(1)
################################################################################
## 1. Problem setup
################################################################################
d <- 20
x_star <- seq(-1, 1, length.out = d)
## FO Hessians (strongly convex)
A1 <- diag(runif(d, 1.5, 2.5))
A2 <- diag(runif(d, 1.5, 2.5))
A3 <- diag(runif(d, 1.5, 2.5))
## ZO Hessians (misaligned, weaker)
B1 <- diag(runif(d, 0.5, 1.2))
B2 <- diag(runif(d, 0.5, 1.2))
B3 <- diag(runif(d, 0.5, 1.2))
## FO functions
f1 <- function(x) { z <- x - x_star; 0.5 * sum((A1 %*% z) * z) }
f2 <- function(x) { z <- x - x_star; 0.5 * sum((A2 %*% z) * z) }
f3 <- function(x) { z <- x - x_star; 0.5 * sum((A3 %*% z) * z) }
## FO gradients
df1 <- function(x) as.numeric(A1 %*% (x - x_star))
df2 <- function(x) as.numeric(A2 %*% (x - x_star))
df3 <- function(x) as.numeric(A3 %*% (x - x_star))
## ZO functions
g1 <- function(x) { z <- x - x_star; 0.5 * sum((B1 %*% z) * z) }
g2 <- function(x) { z <- x - x_star; 0.5 * sum((B2 %*% z) * z) }
g3 <- function(x) { z <- x - x_star; 0.5 * sum((B3 %*% z) * z) }
fi  <- list(f1, f2, f3, g1, g2, g3)
dfi <- list(df1, df2, df3, NULL, NULL, NULL)
fo_ids <- 1:3
zo_ids <- 4:6
n_g <- length(fo_ids)
n_f <- length(zo_ids)
n   <- n_g + n_f
## Global objective
F_obj <- function(x) mean(vapply(fi, function(f) f(x), numeric(1)))
################################################################################
## 2. Gradient estimators (ALL FIXED)
################################################################################
sample_v <- function() rnorm(d)
## 1) Parallel
grad_parallel <- function(x, delta) {
v <- sample_v()
grad_fo <- as.numeric(
colMeans(vapply(fo_ids, function(i) dfi[[i]](x), numeric(d)))
)
grad_fo <- (n_g / n) * grad_fo
zo_each <- vapply(zo_ids, function(i) {
(fi[[i]](x + delta*v) - fi[[i]](x - delta*v)) / (2*delta)
}, numeric(1))
grad_fo + (n_f / n) * mean(zo_each) * v
}
## 2) Proposed (FO surrogate, CORRECT scaling)
grad_proposed <- function(x, delta) {
v <- sample_v()
grad_fo_avg <- as.numeric(
colMeans(vapply(fo_ids, function(i) dfi[[i]](x), numeric(d)))
)
zo_each <- vapply(zo_ids, function(i) {
(fi[[i]](x + delta*v) - fi[[i]](x - delta*v)) / (2*delta)
}, numeric(1))
zo_avg  <- mean(zo_each)
proj_fo <- sum(grad_fo_avg * v)
grad_fo_avg + (n_f / n) * (zo_avg - proj_fo) * v / d
}
## 3) ZORO + Parallel
grad_zoro_parallel <- function(x, delta, m = 10) {
grad_fo <- as.numeric(
colMeans(vapply(fo_ids, function(i) dfi[[i]](x), numeric(d)))
)
grad_fo <- (n_g / n) * grad_fo
res <- rep(0, d)
for (j in 1:m) {
v <- sample_v()
zo_each <- vapply(zo_ids, function(i) {
(fi[[i]](x + delta*v) - fi[[i]](x)) / delta
}, numeric(1))
res <- res + mean(zo_each) * v / d
}
grad_fo + (n_f / n) * res / m
}
## 4) ZORO + Proposed (BEST)
grad_zoro_proposed <- function(x, delta, m = 10) {
grad_fo_avg <- as.numeric(
colMeans(vapply(fo_ids, function(i) dfi[[i]](x), numeric(d)))
)
res <- rep(0, d)
for (j in 1:m) {
v <- sample_v()
zo_each <- vapply(zo_ids, function(i) {
(fi[[i]](x + delta*v) - fi[[i]](x)) / delta
}, numeric(1))
res <- res + (mean(zo_each) - sum(grad_fo_avg * v)) * v / d
}
grad_fo_avg + (n_f / n) * res / m
}
################################################################################
## 3. Optimization loop
################################################################################
simulate <- function(method, x0, delta = 0.05, eta = 0.4, T = 40, seed = 1) {
set.seed(seed)
x <- x0
Fvals <- numeric(T + 1)
Fvals[1] <- F_obj(x)
for (t in 1:T) {
step <- eta / sqrt(t)
g <- switch(method,
parallel = grad_parallel(x, delta),
proposed = grad_proposed(x, delta),
zoro_parallel = grad_zoro_parallel(x, delta),
zoro_proposed = grad_zoro_proposed(x, delta))
x <- x - step * g
Fvals[t + 1] <- F_obj(x)
}
data.frame(iter = 0:T, F = Fvals, method = method)
}
################################################################################
## 4. Run experiment & plot
################################################################################
#pdf("d20_corrected_4methods.pdf", width = 12, height = 4)
par(mfrow = c(1, 3), mar = c(4,4,2,1))
x0_list <- list(
x_star,
x_star - 0.5,
x_star - 1.5
)
methods <- c("parallel", "proposed", "zoro_parallel", "zoro_proposed")
cols <- c(parallel="red", proposed="blue",
zoro_parallel="orange", zoro_proposed="darkgreen")
num_rep <- 10
T <- 40
for (x0 in x0_list) {
all <- list()
for (s in 1:num_rep) {
for (m in methods) {
all[[length(all)+1]] <- simulate(m, x0, seed = 100*s + match(m, methods))
}
}
dat <- do.call(rbind, all)
ylim <- range(dat$F)
plot(NA, xlim = c(0,T), ylim = ylim,
xlab = "Iteration", ylab = "F(x)",
main = paste("Init =", round(x0[1],2)))
## individual trajectories (thin)
for (m in methods) {
sub <- dat[dat$method == m, ]
idx <- split(1:nrow(sub), rep(1:num_rep, each = T+1))
for (k in 1:num_rep) {
lines(sub$iter[idx[[k]]], sub$F[idx[[k]]],
col = adjustcolor(cols[m], alpha.f = 0.25))
}
}
## mean trajectories (thick)
for (m in methods) {
sub <- dat[dat$method == m, ]
meanF <- tapply(sub$F, sub$iter, mean)
lines(as.numeric(names(meanF)), meanF,
col = cols[m], lwd = 3)
}
legend("topright",
legend = c("Parallel", "Proposed",
"ZORO + Parallel", "ZORO + Proposed"),
col = cols, lwd = 3, bty = "n")
}
