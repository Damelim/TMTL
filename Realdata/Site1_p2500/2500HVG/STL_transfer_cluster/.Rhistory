# Conjugate Gradient vs Gradient Descent (2D quadratic example)
# Quadratic: f(x) = 1/2 x^T A x - b^T x
A <- matrix(c(10, 8,
8, 10), nrow=2, byrow=TRUE)
b <- c(1, 1)
f <- function(x) {
0.5 * t(x) %*% A %*% x - t(b) %*% x
}
grad <- function(x) {
A %*% x - b
}
# True solution
x_star <- solve(A, b)
# Initial point
x0 <- c(-3, 3)
# ---------------- Gradient Descent ----------------
gd_path <- matrix(NA, nrow=21, ncol=2)
gd_path[1,] <- x0
x <- x0
eta <- 0.05
for (k in 1:20) {
x <- x - eta * grad(x)
gd_path[k+1,] <- x
}
# ---------------- Conjugate Gradient ----------------
cg_path <- matrix(NA, nrow=3, ncol=2)
cg_path[1,] <- x0
x <- x0
r <- b - A %*% x
p <- r
for (k in 1:2) {  # at most n steps
Ap <- A %*% p
alpha <- as.numeric(t(r) %*% r / (t(p) %*% Ap))
x <- x + alpha * p
cg_path[k+1,] <- x
r_new <- r - alpha * Ap
if (sqrt(sum(r_new^2)) < 1e-8) break
beta <- as.numeric(t(r_new) %*% r_new / (t(r) %*% r))
p <- r_new + beta * p
r <- r_new
}
# ---------------- Plot ----------------
x1 <- seq(-4, 4, length=200)
x2 <- seq(-4, 4, length=200)
z <- outer(x1, x2, Vectorize(function(x1, x2) {
x <- c(x1, x2)
0.5 * t(x) %*% A %*% x - t(b) %*% x
}))
contour(x1, x2, z, nlevels=30, main="GD vs CG Trajectories",
xlab="x1", ylab="x2")
lines(gd_path[,1], gd_path[,2], col="blue", lwd=2)
points(gd_path[,1], gd_path[,2], col="blue", pch=16)
lines(cg_path[,1], cg_path[,2], col="red", lwd=2)
points(cg_path[,1], cg_path[,2], col="red", pch=16)
points(x_star[1], x_star[2], pch=8, cex=1.5)
legend("topright", legend=c("Gradient Descent","Conjugate Gradient","Solution"),
col=c("blue","red","black"), lwd=c(2,2,NA), pch=c(16,16,8))
