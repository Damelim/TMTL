sigma <- function(u) 1 / (1 + exp(-u))
lambda_fun <- function(xi){
(sigma(xi) - 0.5) / (2 * xi)
}
jaakkola_bound <- function(u, xi){
sigma(xi) * exp( (u - xi)/2 - lambda_fun(xi) * (u^2 - xi^2) )
}
# grid
u_seq <- seq(-5, 5, length.out = 500)
# choose expansion point
xi <- 1
# values
sig_vals <- sigma(u_seq)
bound_vals <- jaakkola_bound(u_seq, xi)
# plot
plot(u_seq, sig_vals, type = "l", lwd = 2,
col = "blue", ylim = c(0,1),
xlab = "u", ylab = "",
main = paste("Sigmoid vs Jaakkola bound (xi =", xi, ")"))
lines(u_seq, bound_vals, col = "red", lwd = 2, lty = 2)
points(xi, sigma(xi), pch = 19)
legend("topleft",
legend = c("sigmoid", "Jaakkola bound"),
col = c("blue","red"),
lty = c(1,2), lwd = 2)
